<?xml version="1.0" encoding="UTF-8"?>
<manifest identifier="VR_SHOW_SCORM_PACKAGE" version="1.3"
          xmlns="http://www.imsglobal.org/xsd/imscp_v1p1"
          xmlns:adlcp="http://www.adlnet.org/xsd/adlcp_v1p3"
          xmlns:adlseq="http://www.adlnet.org/xsd/adlseq_v1p3"
          xmlns:adlnav="http://www.adlnet.org/xsd/adlnav_v1p3"
          xmlns:imsss="http://www.imsglobal.org/xsd/imsss">

    <metadata>
        <schema>ADL SCORM</schema>
        <schemaversion>2004 4th Edition</schemaversion>
    </metadata>

    <organizations default="VRLAB">
        <organization identifier="VRLAB">
            <title>VR Show Interactive Experience</title>
            <item identifier="VR_SHOW_ITEM" identifierref="VR_SHOW_RESOURCE">
                <title>VR Show</title>
                <adlcp:masteryscore>60</adlcp:masteryscore>
                <adlcp:maxtimeallowed>PT2H</adlcp:maxtimeallowed>
                <adlcp:timelimitaction>continue,no message</adlcp:timelimitaction>
                <adlcp:datafromlms></adlcp:datafromlms>
                <adlcp:completionthreshold>0.6</adlcp:completionthreshold>
            </item>
        </organization>
    </organizations>

    <resources>
        <resource identifier="VR_SHOW_RESOURCE" type="webcontent" adlcp:scormType="sco" href="index.html">
            <file href="index.html"/>
            <file href="engine/loader.js"/>
            <file href="engine/utilities.js"/>
            <file href="engine/vr_menu.js"/>
            <file href="engine/interactions.js"/>
            <file href="engine/animations.js"/>
            <file href="data/config.json"/>
            <file href="data/speeches.json"/>
            <file href="data/quiz_data.json"/>
            <file href="data/woman_lt.json"/>
            <file href="data/woman_en.json"/>
            <file href="data/man_lt.json"/>
            <file href="data/man_en.json"/>
            <file href="models/modelis.glb"/>
            <file href="models/man_talk.glb"/>
            <file href="models/woman_talk.glb"/>
            <file href="models/show_man.glb"/>
            <file href="models/chair.glb"/>
            <file href="video.mp4"/>
        </resource>
    </resources>
</manifest>